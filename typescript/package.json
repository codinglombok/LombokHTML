{
  "name": "lombokhtml",
  "version": "0.2.0",
  "description": "WHATWG HTML tokenizer (html5lib-tests conformant), tree builder, serializer, text extraction, allowlist sanitizer, CSS selector subset, meta and table extraction with identical results in TypeScript, Rust, Python, Go and PHP. No dependencies. Part of the Lombok Ecosystem.",
  "keywords": [
    "html",
    "parser",
    "tokenizer",
    "whatwg",
    "sanitizer",
    "css-selector",
    "html-to-text",
    "zero-dependency",
    "lombok-ecosystem"
  ],
  "homepage": "https://github.com/codinglombok/LombokHTML",
  "bugs": {
    "url": "https://github.com/codinglombok/LombokHTML/issues"
  },
  "license": "Apache-2.0",
  "author": "codinglombok",
  "repository": {
    "type": "git",
    "url": "https://github.com/codinglombok/LombokHTML.git",
    "directory": "typescript"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/*.js",
    "dist/*.d.ts",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:test": "tsc -p tsconfig.test.json",
    "test": "npm run build:test && cd build && node --test",
    "coverage": "npm run build:test && node scripts/coverage.mjs build",
    "lint": "tsc -p tsconfig.test.json --noEmit",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.9.3"
  }
}
